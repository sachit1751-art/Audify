{
 "version": 1,
 "description": "Shared test vectors for the AUDIFY social layer (Plan 091). Both the Android/shared Kotlin code and the backend must produce exactly these results. Expected values are written by hand, not generated by either implementation. An input is a string, or {\"repeat\": unit, \"times\": n} meaning unit repeated n times. A null expected value means 'rejected'. Unicode is written with \\u escapes; lone surrogates are intentional. To change a rule, change this file, the Kotlin rules and the backend in the same change.",
 "limits": {
  "usernameMin": 3,
  "usernameMax": 20,
  "displayNameMax": 40,
  "bioMax": 160,
  "pageDefault": 20,
  "pageMax": 50,
  "usernameCooldownDays": 30,
  "usernameReleaseHoldDays": 30,
  "searchMinPrefix": 2,
  "cursorMax": 256
 },
 "reservedUsernames": [
  "admin",
  "administrator",
  "api",
  "help",
  "mod",
  "moderator",
  "null",
  "official",
  "root",
  "security",
  "settings",
  "staff",
  "support",
  "system",
  "undefined"
 ],
 "reservedUsernamePrefixes": [
  "audify"
 ],
