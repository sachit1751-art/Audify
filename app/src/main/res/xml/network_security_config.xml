<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext (http/ws) traffic is not permitted anywhere in the app.

    Every first-party endpoint (YouTube, LastFM, Discord gateway, lyrics
    providers, the updater and the Listen Together server) is reached over
    HTTPS/WSS. The Listen Together custom-server flow used to be the single
    reason for allowing cleartext app-wide; it now requires a wss:// URL, so
    the exemption is no longer needed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
