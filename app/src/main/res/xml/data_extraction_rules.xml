<!--
   Backup and device-transfer rules for Android 12 and newer; see
   backup_rules.xml for why these files are excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="audify_auth.xml" />
        <exclude domain="sharedpref" path="audify_auth_plain.xml" />
        <exclude domain="sharedpref" path="audify_sources.xml" />
        <exclude domain="sharedpref" path="audify_sources_plain.xml" />
        <!-- Playback queues are local session state; do not resurrect them after reinstall. -->
        <exclude domain="sharedpref" path="audify_last_played.xml" />
        <exclude domain="sharedpref" path="audify_bounded_context.xml" />
        <exclude domain="sharedpref" path="audify_party_queue_stash.xml" />
        <exclude domain="sharedpref" path="audify_wallpaper.xml" />
        <exclude domain="file" path="theme-backgrounds/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="audify_auth.xml" />
        <exclude domain="sharedpref" path="audify_auth_plain.xml" />
        <exclude domain="sharedpref" path="audify_sources.xml" />
        <exclude domain="sharedpref" path="audify_sources_plain.xml" />
        <!-- Playback queues are local session state; do not resurrect them after reinstall. -->
        <exclude domain="sharedpref" path="audify_last_played.xml" />
        <exclude domain="sharedpref" path="audify_bounded_context.xml" />
        <exclude domain="sharedpref" path="audify_party_queue_stash.xml" />
        <exclude domain="sharedpref" path="audify_wallpaper.xml" />
        <exclude domain="file" path="theme-backgrounds/" />
    </device-transfer>
</data-extraction-rules>
