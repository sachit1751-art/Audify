diff --git a/crates/gpui/src/window.rs b/crates/gpui/src/window.rs
index 1b7fd4d..5d128f3 100644
--- a/crates/gpui/src/window.rs
+++ b/crates/gpui/src/window.rs
@@ -2786,8 +2786,13 @@ impl Window {
     /// method directly for decorative motion, check [`App::reduce_motion`]
     /// and skip the frame request when it is set.
     pub fn request_animation_frame(&self) {
-        let entity = self.current_view();
-        self.on_next_frame(move |_, cx| cx.notify(entity));
+        if let Some(entity) = self.rendered_entity_stack.last().copied() {
+            self.on_next_frame(move |_, cx| cx.notify(entity));
+        } else {
+            // Animation can be requested without an active rendered-view scope.
+            // Refresh the whole window rather than unwrapping an empty view stack.
+            self.on_next_frame(|window, _| window.refresh());
+        }
     }
